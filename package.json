{
  "name": "EleventyOne",
  "version": "3.0.0",
  "description": "A project bootstrap for Eleventy sites. With pipelines for PostCSS, JavaScript, and serverless functions",
  "author": "Phil Hawksworth",
  "license": "MIT",
  "scripts": {
    "start": "npm run dev",
    "dev": "cross-env ELEVENTY_ENV=dev eleventy --serve",
    "build": "cross-env ELEVENTY_ENV=prod eleventy",
    "seed": "cross-env ELEVENTY_ENV=seed eleventy"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/philhawksworth/eleventyone"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.7",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@google-cloud/local-auth": "^3.0.1",
    "autoprefixer": "^9.8.8",
    "axios": "^1.20.0",
    "calendar-heatmap-graph": "0.0.14",
    "cssnano": "^7.1.9",
    "goodreads-api-node": "github:cjavdev/goodreads-api-node#master",
    "googleapis": "^188.0.0",
    "html-minifier": "^4.0.0",
    "luxon": "^3.7.2",
    "postcss": "^8.5.31",
    "postcss-color-mix": "^1.1.0",
    "postcss-comment": "^2.0.0",
    "postcss-import": "^16.2.0",
    "postcss-mixins": "^12.1.2",
    "postcss-simple-vars": "^6.0.3",
    "precss": "^4.0.0",
    "uglify-js": "^3.19.3",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eleventy-plugin-lazyimages": "^2.1.2"
  }
}
